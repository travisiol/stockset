# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://stockset.example

# --- Protocol -----------------------------------------------------------
# Leave the factory address unset until the contracts are deployed. With it
# unset the whole app sits in PREVIEW: wallets connect, every write button is
# disabled and says why, and every counter reads a real zero.
NEXT_PUBLIC_STOCKSET_FACTORY_ADDRESS=
# Needs to be true AND a factory address before anything can be deployed.
NEXT_PUBLIC_STOCKSET_LIVE=false

# --- Fee split ----------------------------------------------------------
# Percentages of trade notional, e.g. 0.20. All three must be set before the
# fee chart shows figures; while any is missing the page says the split is
# not decided rather than printing a number that might change.
NEXT_PUBLIC_STOCKSET_FEE_CREATOR=
NEXT_PUBLIC_STOCKSET_FEE_PROTOCOL=
NEXT_PUBLIC_STOCKSET_FEE_LIQUIDITY=

# --- Network ------------------------------------------------------------
# Robinhood Chain. The defaults in src/lib/chain.ts are third-party research
# and must be re-confirmed against docs.robinhood.com/chain before mainnet.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=

# --- Socials (hidden from the footer while unset) -----------------------
NEXT_PUBLIC_STOCKSET_X=
NEXT_PUBLIC_STOCKSET_DISCORD=
NEXT_PUBLIC_STOCKSET_DOCS=
